@model IEnumerable<Hospital_full_Project.Models.Patient>

<h2>Patient List</h2>

<p>
    <a asp-action="Create">Add New Patient</a>
</p>

<br />
<table class="table table-striped table table-hover">
    <thead>
        <tr>
            <th>Patient Id</th>
            <th>Name</th>
            <th>Age</th>
            <th>Gender</th>
            <th>Phone</th>
            <th>Address</th>
            <th>Action</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.PatientId</td>
                <td>@item.Name</td>
                <td>@item.Age</td>
                <td>@item.Gender</td>
                <td>@item.Phone</td>
                <td>@item.Address</td>
            

                <td>
                    <a asp-action="Details"
                       asp-route-id="@item.PatientId">
                        Details
                    </a>

                    <a asp-action="Edit"
                       asp-route-id="@item.PatientId">
                        Edit
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@item.PatientId">
                        Delete
                    </a>
                </td>
                </tr>
                
        }
    </tbody>
</table>
